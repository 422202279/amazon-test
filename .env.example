APP_ENV=production
API_PREFIX=/api
DATABASE_URL=sqlite:///./data/crossborder_monitor.db
ADMIN_EMAIL=admin@your-domain.com
# Set a strong one-time password before the first production start. Do not commit .env.
ADMIN_INITIAL_PASSWORD=change-this-before-production
SESSION_TTL_HOURS=168
# Same-origin Nginx deployments can leave this empty. Add only trusted browser origins if needed.
CORS_ORIGINS=https://your-domain.com
DEFAULT_SCHEDULE_TIMES=06:00
MAX_SCHEDULE_TIMES=3
